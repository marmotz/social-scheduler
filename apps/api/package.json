{
  "name": "@sonskay/api",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "types": "./src/trpc/trpc.router.ts",
  "exports": {
    ".": "./src/trpc/trpc.router.ts"
  },
  "scripts": {
    "clean": "rm -rf dist generated node_modules",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "bun x prisma generate --watch",
    "prisma:generate:ci": "bun x prisma generate",
    "prisma:migrate": "bun x prisma migrate dev",
    "db:setup": "bun run db:reset && bun run db:seed",
    "db:reset": "bun x prisma migrate reset --force",
    "db:seed": "echo 'No seed yet' #bun seeds/seeds.ts",
    "generate:encryption-key": "bun run scripts/generate-encryption-key.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sonskay/shared": "workspace:*",
    "@trpc/server": "^11.18.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "minio": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.46",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.2",
    "@types/luxon": "^3.7.2",
    "@types/ms": "^2.1.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/qs": "^6.15.1",
    "prisma": "^7.9.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
