{
  "name": "@sonskay/api",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist generated node_modules",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "bun x prisma generate --watch",
    "prisma:generate:ci": "bun x prisma generate",
    "prisma:migrate": "bun x prisma migrate dev",
    "db:setup": "bun run db:reset && bun run db:seed",
    "db:reset": "bun x prisma migrate reset --force",
    "db:seed": "echo 'No seed yet' #bun seeds/seeds.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sonskay/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.46",
    "@types/express": "^5.0.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
